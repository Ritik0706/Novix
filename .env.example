# Copy this file to novix/novix/config.env before running the Django backend.
# Generate a private key with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-private-django-secret-key

# Optional: auto, cpu, cuda, or vulkan
NOVIX_RUNTIME=auto
